# EvidenceRAG Environment Configuration
PROJECT_NAME=EvidenceRAG
ENVIRONMENT=development
DEBUG=True

# Security
SECRET_KEY=evidencerag-super-secret-development-key-32-chars-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./storage/evidencerag.db

# Storage Directories
UPLOAD_DIR=./storage/uploads
REPORTS_DIR=./storage/reports
DATASET_DIR=./dataset
MODELS_DIR=./models

# OCR Engine
TESSERACT_CMD=tesseract

# AI / LLM / RAG Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Verification Config
SIMILARITY_THRESHOLD=0.85
MAX_UPLOAD_SIZE_MB=25
